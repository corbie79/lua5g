{
  "name": "dala",
  "displayName": "Dala Language Support",
  "description": "Syntax highlighting, snippets, LSP, and debugging for Dala",
  "version": "0.2.0",
  "publisher": "dala",
  "icon": "icon.svg",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages", "Debuggers"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:dala"],
  "contributes": {
    "languages": [{
      "id": "dala",
      "aliases": ["Dala", "dala"],
      "extensions": [".lua", ".dala", ".d.lua"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "dala",
      "scopeName": "source.dala",
      "path": "./syntaxes/dala.tmLanguage.json"
    }],
    "snippets": [{
      "language": "dala",
      "path": "./snippets/dala.json"
    }],
    "configuration": {
      "title": "Dala",
      "properties": {
        "dala.luaPath": {
          "type": "string",
          "default": "dala",
          "description": "Path to dala executable"
        },
        "dala.lspEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable LSP server"
        }
      }
    },
    "breakpoints": [{"language": "dala"}],
    "debuggers": [{
      "type": "dala",
      "label": "Dala Debug",
      "program": "./debugAdapter.js",
      "runtime": "node",
      "languages": ["dala"],
      "configurationAttributes": {
        "launch": {
          "required": ["program"],
          "properties": {
            "program": {
              "type": "string",
              "description": "Lua script to debug"
            },
            "luaPath": {
              "type": "string",
              "default": "dala",
              "description": "Path to dala"
            }
          }
        }
      },
      "initialConfigurations": [{
        "type": "dala",
        "request": "launch",
        "name": "Debug Dala",
        "program": "${file}"
      }]
    }]
  }
}
